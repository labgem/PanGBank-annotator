From be62ed0da14be098a735ab6cc6e9ae445c18e40f Mon Sep 17 00:00:00 2001
From: yazid-hoblos <yazid.hoblos@lau.edu>
Date: Sun, 26 Jul 2026 13:33:29 +0200
Subject: [PATCH] imported workflow: localize sequences.db for SQLite-heavy steps

---
 modules/prepare_sequences/main.nf | 79 ++++++++++++++++++++++++++++---
 modules/write_output/main.nf      | 57 ++++++++++++++++++++--
 2 files changed, 124 insertions(+), 12 deletions(-)

diff --git a/modules/prepare_sequences/main.nf b/modules/prepare_sequences/main.nf
index 6cdda3a5..f6ea7b1d 100644
--- a/modules/prepare_sequences/main.nf
+++ b/modules/prepare_sequences/main.nf
@@ -58,10 +58,16 @@ process LOAD_ORFS {
     db.close()
 }
 
+import uk.ac.ebi.interpro.SeqDB
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.StandardCopyOption
+
 process SPLIT_FASTA {
-    // Build the FASTA file batches of unique protein sequences for the sequence analysis
-    label         'mem_low'
-    label         'time_short'
+    // Build FASTA batches of unique protein sequences
+    label 'mem_low'
+    label 'time_short'
+
     executor      'local'
     errorStrategy 'terminate'
 
@@ -71,10 +77,69 @@ process SPLIT_FASTA {
     val nucleic
 
     output:
-    path "*.fasta"
+    path '*.fasta'
 
     exec:
-    def db = new uk.ac.ebi.interpro.SeqDB(db_path)
-    db.splitFasta(task.workDir, batch_size, nucleic)
-    db.close()
+    Path sourceDb = db_path instanceof Path
+        ? db_path
+        : Path.of(db_path.toString())
+
+    Path tmpRoot = Path.of(
+        System.getenv('TMPDIR')
+            ?: System.getProperty('java.io.tmpdir')
+            ?: '/tmp'
+    )
+
+    Files.createDirectories(tmpRoot)
+
+    Path localDir = Files.createTempDirectory(
+        tmpRoot,
+        'interproscan-split-'
+    )
+
+    Path localDb = localDir.resolve('sequences.db')
+
+    try {
+        log.info "Copying sequence database from ${sourceDb} to ${localDb}"
+
+        // One sequential transfer from shared storage
+        Files.copy(
+            sourceDb,
+            localDb,
+            StandardCopyOption.REPLACE_EXISTING
+        )
+
+        // SQLite reads and FASTA generation happen on local storage
+        SeqDB db = new SeqDB(localDb)
+
+        try {
+            db.splitFasta(
+                localDir,
+                batch_size as int,
+                nucleic as boolean
+            )
+        }
+        finally {
+            db.close()
+        }
+
+        // Nextflow only detects declared outputs in task.workDir
+        Files.list(localDir).withCloseable { stream ->
+            stream
+                .filter { path ->
+                    Files.isRegularFile(path) &&
+                    path.fileName.toString().endsWith('.fasta')
+                }
+                .forEach { path ->
+                    Files.move(
+                        path,
+                        task.workDir.resolve(path.fileName),
+                        StandardCopyOption.REPLACE_EXISTING
+                    )
+                }
+        }
+    }
+    finally {
+        localDir.toFile().deleteDir()
+    }
 }
\ No newline at end of file
diff --git a/modules/write_output/main.nf b/modules/write_output/main.nf
index a579a603..0353c8af 100644
--- a/modules/write_output/main.nf
+++ b/modules/write_output/main.nf
@@ -1,3 +1,7 @@
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.StandardCopyOption
+
 process WRITE_GFF3 {
     label    'mem_medium'
     label    'time_long'
@@ -67,11 +71,54 @@ process WRITE_TSV {
     val output_file
 
     exec:
-    uk.ac.ebi.interpro.ProcessOutputTSV.run(
-        matches_files,
-        seq_db_file,
-        nucleic,
-        output_file)
+    Path sourceDb = seq_db_file instanceof Path
+        ? seq_db_file
+        : Path.of(seq_db_file.toString())
+
+    Path finalOutput = output_file instanceof Path
+        ? output_file
+        : Path.of(output_file.toString())
+
+    Path tmpRoot = Path.of(
+        System.getenv('TMPDIR')
+            ?: System.getProperty('java.io.tmpdir')
+            ?: '/tmp'
+    )
+
+    Files.createDirectories(tmpRoot)
+
+    Path localDir = Files.createTempDirectory(
+        tmpRoot,
+        'interproscan-tsv-'
+    )
+
+    Path localDb = localDir.resolve('sequences.db')
+
+    try {
+        log.info "Copying sequence database from ${sourceDb} to ${localDb}"
+
+        Files.copy(
+            sourceDb,
+            localDb,
+            StandardCopyOption.REPLACE_EXISTING
+        )
+
+        if (finalOutput.parent != null) {
+            Files.createDirectories(finalOutput.parent)
+        }
+
+        log.info "Writing TSV output to ${finalOutput} using local database ${localDb}"
+
+        uk.ac.ebi.interpro.ProcessOutputTSV.run(
+            matches_files as List<Path>,
+            localDb,
+            nucleic as boolean,
+            finalOutput
+        )
+    }
+    finally {
+        localDir.toFile().deleteDir()
+    }
 }
 
 process WRITE_XML {
-- 
2.52.0

