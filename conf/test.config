/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run labgem/PanGBank-annotator -profile test,local_tools --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    cpus = 1
    withLabel:process_low {
        cpus = 1
    }
    withLabel:process_medium {
        cpus = 1
    }
    withLabel:process_high {
        cpus = 1
    }
    withLabel:process_deepclust {
        cpus = 1
    }
    withName:MULTIQC {
        cpus = 1
    }
    resourceLimits = [
        cpus: 1,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Built-in small FASTA dataset used for fast local smoke tests.
    test_data      = "${projectDir}/tests/data/test_representatives.faa"
    test_release_id = 'rtest'
    outdir         = 'results/test'
    levels         = 'deep,50,80'
    deep_approx_id = 0

    // Keep real InterProScan tests bounded.
    interpro_mode = 'native'
    interproscan6_batch_size = 1000
    interproscan6_no_matches_api = true

    // Local smoke tests can use the shared DeepKOALA checkout on this cluster.
    deepkoala_workdir     = '/env/cns/home/yhoblos/deepkoala'
    deepkoala_num_workers = 0
}
